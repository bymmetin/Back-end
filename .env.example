# .env.example — Bu dosyayı .env olarak kopyala ve değerleri doldur.
# .env asla Git'e commit edilmez (.gitignore'a eklenmiş olmalı).

# PostgreSQL Veritabanı Bağlantısı
# Supabase projesinde: Settings > Database > Connection Info
DB_HOST=db.gyucxqpvrczuqqqhtrkm.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=SUPABASE_DB_SIFRENIZI_BURAYA_YAZIN
DB_NAME=postgres
DB_SSL=true

# JWT Anahtarları — tahmin edilemez uzun string kullan
JWT_SECRET=mnemo_super_gizli_anahtar_2025_degistir
JWT_EXPIRES_IN=3600s
JWT_REFRESH_SECRET=mnemo_refresh_gizli_anahtar_2025_degistir
JWT_REFRESH_EXPIRES_IN=7d

# Ortam
NODE_ENV=development
